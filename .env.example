# Copy this file to .env and adjust if needed.
PORT=3001
VITE_SIGNALING_URL=http://localhost:3001
# Origin the client is served from — used for CORS on both HTTP and Socket.IO.
CLIENT_ORIGIN=http://localhost:5173

# TURN relay (server-side) — needed for calls between people on networks that
# block direct connections (mobile data, strict Wi-Fi). Either Cloudflare:
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# ...or a provider with a fixed login (e.g. Metered):
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Cloudflare SFU (server-side) — calls go through Cloudflare instead of every
# browser sending video to every other browser, so rooms can be bigger, and a
# listener's audio is cut off by the server. Without these, calls stay
# peer-to-peer (fine for about 5-6 people with cameras on).
# Cloudflare dashboard -> Realtime -> SFU -> create an app:
# CLOUDFLARE_SFU_APP_ID=
# CLOUDFLARE_SFU_APP_SECRET=

# Meeting recordings (server-side) — saved in Cloudflare R2. Browsers never
# talk to R2 (some networks can't reach it): recordings go through the server.
# Without these, recordings are saved in a temp folder on the server instead
# (fine for local development; lost whenever the server restarts).
# Cloudflare dashboard -> R2 -> create a bucket, then an Account API token
# with "Object Read & Write" on that bucket:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=listen-recordings

# Reviews written on the "You left the meeting" screen are emailed through
# Resend (resend.com). Without these they're written to the server log.
# RESEND_API_KEY=
# FEEDBACK_TO=
# Optional sender; the default (onboarding@resend.dev) only delivers to the
# email address of your own Resend account.
# FEEDBACK_FROM=
